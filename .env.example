# =================================================================
# CAU HINH HE THONG ZALO AI BOT (RAG & MINI CRM)
# =================================================================

# Server
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Zalo Bot Platform & Webhook (https://bot.zapps.me)
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_APP_SECRET=your_zalo_app_secret_here
ZALO_API_BASE_URL=https://bot-api.zaloplatforms.com

# Google Gemini AI (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Cloud Database URL (Ket noi PostgreSQL external nhu Neon.tech / Supabase)
DATABASE_URL=your_external_database_url_here

# JWT Security
JWT_SECRET=zalo_ai_crm_super_secret_jwt_key_2026_change_me_in_production
JWT_EXPIRES_IN=7d

# RAG & Knowledge Base
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=150
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=4

# Human Handoff Keywords
HANDOFF_KEYWORDS=gặp nhân viên,tư vấn viên,gặp người thật,chăm sóc khách hàng,kết nối cskh,hỗ trợ viên,gặp cskh,nói chuyện với người,liên hệ nhân viên
